{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/lansman/:slug",
      "destination": "/lansman.html?launch=:slug"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.yagandijital.com/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/demo-merkezi",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.yagandijital.com/demo-merkezi>; rel=\"canonical\""
        }
      ]
    }
  ]
}
